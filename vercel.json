{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/grupos",
      "destination": "/grupos.json"
    },
    {
      "source": "/api/status",
      "destination": "/grupos.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}